# ==============================================================================
# Kairo Raft Distributed KV Store - Environment Configuration
# ==============================================================================

# Docker image to run
KAIRO_IMAGE=kairo:latest

# Total number of nodes in the cluster (e.g. 1, 3, 5)
# When set, Kairo auto-derives peer topologies without needing manual peer strings!
KAIRO_CLUSTER_SIZE=3

# Logging configuration: debug, info, warn, error
KAIRO_LOG_LEVEL=info

# Logging format: text, json
KAIRO_LOG_FORMAT=text

# Authentication credentials (persisted to volume /data/auth.json on first boot)
# To reset credentials, purge the Docker data volume (e.g. docker volume rm / make clean)
KAIRO_AUTH_USER=kairo
KAIRO_AUTH_PASSWORD=kairo-secret

# Enable Pre-Vote protocol (§9.6) to avoid disruptive elections during partitions
KAIRO_PRE_VOTE=true

# Host port mappings for client HTTP endpoints
KAIRO_NODE1_PORT=9001
KAIRO_NODE2_PORT=9002
KAIRO_NODE3_PORT=9003
KAIRO_NODE4_PORT=9004
KAIRO_NODE5_PORT=9005

# Host port mapping for Kairo L7 Cluster Proxy
KAIRO_PROXY_PORT=8999

# ------------------------------------------------------------------------------
# Granular / Advanced Options (Optional overrides)
# ------------------------------------------------------------------------------
# KAIRO_ID=1
# KAIRO_ADDR=0.0.0.0:8000
# KAIRO_CLIENT_ADDR=0.0.0.0:9000
# KAIRO_DATA_DIR=/data
# KAIRO_PEER_HOST_TEMPLATE=kairo-%d:8000
# KAIRO_PEERS=2=kairo-2:8000,3=kairo-3:8000
# KAIRO_PROXY_LISTEN=:8999
# KAIRO_PROXY_ENDPOINTS=http://kairo-1:9000,http://kairo-2:9000,http://kairo-3:9000
# KAIRO_PROXY_POLL_INTERVAL=1s
